{
  "name": "dsh-wakeword",
  "version": "0.1.1",
  "private": true,
  "description": "Wake-word triggered hands-free voice input for DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wakeword",
    "keyword-spotting",
    "voice"
  ],
  "license": "MIT",
  "dependencies": {
    "pinyin-pro": "^3.29.5",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.1"
  }
}
